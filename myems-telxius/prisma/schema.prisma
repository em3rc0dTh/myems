generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- FASE 1: DOMINIO GEOGRÁFICO (ESTÁTICO) ---

model Country {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String   @unique
  regions Region[]
}

model Region {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  countryId String     @db.ObjectId
  country   Country    @relation(fields: [countryId], references: [id])
  provinces Province[]
}

model Province {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  regionId String   @db.ObjectId
  region   Region   @relation(fields: [regionId], references: [id])
  towns    Town[]
}

model Town {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  provinceId String     @db.ObjectId
  province   Province   @relation(fields: [provinceId], references: [id])
  districts  District[]
}

model District {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  townId String @db.ObjectId
  town   Town   @relation(fields: [townId], references: [id])
  sites  Site[]
}

model Site {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  districtId      String      @db.ObjectId
  district        District    @relation(fields: [districtId], references: [id])
  address         String?
  geoCoords       String?     // Point anchor [lat, lng]
  perimeter       String?     // SVG Polygon points
  spatialMetadata String?     // Technical rules for site layout
  
  width           Float?      // Physical width anchor
  length          Float?      // Physical length/depth anchor
  isLogical       Boolean     @default(false) // Flag for Almacén Central / Logical pools

  structures      Structure[]
  devices         Device[]
}

// --- FASE 2: DOMINIO OPERATIVO (DINÁMICO - CRUD) ---

model Structure {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  siteId          String  @db.ObjectId
  site            Site    @relation(fields: [siteId], references: [id])
  perimeter       String? // SVG Polygon relative to Site
  spatialMetadata String? // Technical blueprint rules
  levels          Level[]
}

model Level {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  structureId     String         @db.ObjectId
  structure       Structure      @relation(fields: [structureId], references: [id])
  spatialMetadata String?        // Schematic markers
  rooms           Substructure[]
}

model Substructure {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            String      @default("ROOM")
  levelId         String      @db.ObjectId
  level           Level       @relation(fields: [levelId], references: [id])
  
  // -- Propiedades Físicas --
  area            Float?
  width           Float?
  depth           Float?
  length          Float?
  measurementUnit String      @default("METRIC")

  gridRows        String[]
  gridCols        Int[]
  perimeter       String?
  referencePoints String?
  spatialMetadata String?     // Engineering blueprint logic
  racks           Container[]
  positions       Position[]
  rows            Row[]
}

model Row {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String      // Ej: "Fila A", "Bahía 1"
  substructureId  String      @db.ObjectId
  substructure    Substructure @relation(fields: [substructureId], references: [id])
  
  spatialMetadata String?     // Rectángulo de la Bahía en el plano
  containers      Container[]
  positions       Position[]
}

model Container {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            String       @default("RACK")
  substructureId  String       @db.ObjectId
  substructure    Substructure @relation(fields: [substructureId], references: [id])
  
  parentContainerId String?     @db.ObjectId
  parentContainer   Container?  @relation("ContainerHierarchy", fields: [parentContainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childContainers   Container[] @relation("ContainerHierarchy")

  row             String
  rowId           String?      @db.ObjectId
  rowRef          Row?         @relation(fields: [rowId], references: [id])

  position        Int
  spatialMetadata String?      // Footprint details (x, y, w, h)

  width           Float?
  depth           Float?
  height          Float?
  footprintArea   Float?
  measurementUnit String      @default("METRIC")

  mountingWidth   Float?
  mountingDepth   Float?
  mountingHeight  Float?

  assignSpace     Int?         @default(46)
  slots           CAS[]
  devices         Device[]
}

model CAS {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  label       String    // U1, U2, Slot-01
  containerId String    @db.ObjectId
  container   Container @relation(fields: [containerId], references: [id])
  ne          NE?       @relation(fields: [neId], references: [id])
  neId        String?   @db.ObjectId
}

// --- FASE 3a: POSICIÓN FÍSICA (TILE 60x60cm) ---

/// Una posición es la unidad mínima de una sala.
/// Existe aunque esté vacía. Un Device puede ocupar varias posiciones.
model Position {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  substructureId String       @db.ObjectId
  substructure   Substructure @relation(fields: [substructureId], references: [id])

  row            String       // "A", "B", "C" — identificador de fila
  rowId          String?      @db.ObjectId
  rowRef         Row?         @relation(fields: [rowId], references: [id])
  col            Int          // 1, 2, 3 — identificador de columna

  // ── Ocupación en la cuadrícula (tiles de referencia 60×60) ──
  widthUnits     Int          @default(1) // cuántos tiles ocupa en columna (eje X)
  depthUnits     Int          @default(1) // cuántos tiles ocupa en fila   (eje Z)

  // ── Dimensiones físicas reales del device (puede ser no múltiplo de 60) ──
  physWidthCm    Float        @default(60)  // ancho real: 50, 60, 90, 120...
  physDepthCm    Float        @default(60)  // profundidad real: 30, 60, 90...
  physOffsetX    Float?       @default(0)   // Ajuste fino X en cm
  physOffsetY    Float?       @default(0)   // Ajuste fino Y en cm

  status         String       @default("EMPTY")  // EMPTY | OCCUPIED | RESERVED
  label          String?      // etiqueta libre: "BDFB-01", "Rack-Norte"

  deviceId       String?      @db.ObjectId // device que ocupa esta posición
  device         Device?      @relation(fields: [deviceId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// --- FASE 3b: CONTEXTO FÍSICO (EQUIPMENT & HOLDERS) ---

enum EquipmentCategory {
  SHELF         // Chasis completo o rack mountable
  SUBRACK       // Término legacy/alternativo para bastidor
  SUBSHELF      // Sub-bastidor modular (ej: frame del BDFB)
  CIRCUIT_PACK  // Tarjeta o módulo genérico
  CIRCUIT_BREAKER_PANEL // Panel de distribución de breakers
  MODULE_SFP    // Módulo enchufable (SFP, CFP2, etc)
  BREAKER       // Interruptor térmico individual
  POWER_SUPPLY  // Fuente de alimentación dedicada
}

model Device {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  name       String      // Logical Wrapper Name (e.g. BDFB-01-WRAPPER)
  category   String      @default("NETWORKING") 
  sn         String?     @unique // Serial Number del Chasis/Sistema (Mapeo MQTT)
  siteId     String      @db.ObjectId
  site       Site        @relation(fields: [siteId], references: [id])
  
  containerId String?     @db.ObjectId
  container   Container?  @relation(fields: [containerId], references: [id])
  uPosition   Int?        // Posición inicial en el rack (U1, U2...)
  uHeight     Int?        @default(1) // Altura en unidades (Rack Units)

  // -- Propiedades Físicas (Footprint) --
  physWidth   Float?      // Ancho en cm
  physDepth   Float?      // Profundidad/Pisada en cm
  physHeight  Float?      // Altura total en cm

  isPinned    Boolean     @default(false)

  positions  Position[]  // Relación inversa: posiciones que ocupa
  equipments Equipment[] // Colección de hardware que compone este dispositivo
  ports      Port[]      // Puertos maestros del dispositivo
  ne         NE?         // Capa lógica (Network Element)
}

model Equipment {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  name              String            // Ej: "ZTE-N3-PSU", "Panel-A"
  sn                String?           // Serial Number real
  category          EquipmentCategory @default(CIRCUIT_PACK)
  
  // -- Ubicación Física --
  unitPosition      Int?              // U de inicio en el rack
  unitHeight        Int?              // Altura en unidades de rack (U)
  slotLabel         String?           // Etiqueta del slot (ej: "Slot 01")

  // -- Jerarquía de Montaje Físico --
  deviceId          String            @db.ObjectId
  device            Device            @relation(fields: [deviceId], references: [id])
  
  // Si está insertado en una ranura (Holder)
  insertedInId      String?           @unique @db.ObjectId
  insertedIn        Holder?           @relation("SlotOccupancy", fields: [insertedInId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  // Las ranuras que este equipo ofrece
  holders           Holder[]          @relation("HardwareSlots")

  // -- Metadatos Técnicos --
  expectedType      String?           // Planificación: qué modelo debe ir aquí
  logicalPrefix     String?           // Prefijo MQTT manual: "0_1", "0_2"
  actualTemp        Float?            // Telemetría de salud (Opcional)
  isPinned          Boolean           @default(false)
  
  // Recursividad clásica (Composición)
  parentEquipmentId String?           @db.ObjectId
  parent            Equipment?        @relation("Composition", fields: [parentEquipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Equipment[]       @relation("Composition")
  
  ports             Port[]
}

model Holder {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  name              String      // Ej: "Slot-01", "Pos-A1"
  location          String?     // Ruta física: /sh=3/sl=8
  
  parentEquipmentId String      @db.ObjectId
  parentEquipment   Equipment   @relation("HardwareSlots", fields: [parentEquipmentId], references: [id])
  
  // ¿Qué equipo está ocupando este slot?
  occupiedBy        Equipment?  @relation("SlotOccupancy")
}

// --- FASE 3c: CONECTIVIDAD Y ENERGÍA ---

enum PortType {
  POWER_SUPPLY    // Fuente de energía (Feed)
  POWER_DIST      // Distribución (Breaker output)
  POWER_IN        // Alias heredado para entrada
  POWER_OUT       // Alias heredado para salida
  DATA            // Ethernet, Fibra
  TELEMETRY       // Canales de sensores (Efecto Hall)
}

enum PortRole {
  INPUT           // Consumidor de señal/energía
  OUTPUT          // Proveedor de señal/energía
}

model Port {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  name              String      // Ej: "Breaker-01", "Gi0/0"
  type              PortType    @default(DATA)
  role              PortRole?   @default(INPUT)
  
  // -- Telemetría --
  sensorKey         String?     // Clave de sensor MQTT (Estándar 0_N_X)
  sensorTopic       String?     // Alias/Topic legacy
  
  // -- Jerarquía --
  equipmentId       String?     @db.ObjectId
  equipment         Equipment?  @relation(fields: [equipmentId], references: [id])
  deviceId          String      @db.ObjectId
  device            Device      @relation(fields: [deviceId], references: [id])
  
  // -- Atributos de Ingeniería (Física del Cable) --
  maxAmperage       Float?      // Capacidad nominal (ej: 63A)
  nominalVoltage    Float?      // Voltaje (ej: 48V)
  cableGauge        String?     // Calibre (ej: 2AWG, 4AWG)
  cableType         String?     // Tipo (ej: Cu-Multifilar)
  
  clientName        String?     @default("")
  
  sourceConnections Connection[] @relation("SourceConnection")
  targetConnections Connection[] @relation("TargetConnection")
}

// --- FASE 4: CAPA LÓGICA (CONSCIENCIA - NE) ---

model NE {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String // Network Element Logic Name (ej: "Granja-Farid-01")
  deviceId String @unique @db.ObjectId
  device   Device @relation(fields: [deviceId], references: [id])
  slots    CAS[]  // Anclaje físico en el Rack
}

model Connection {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  label        String @default("CABLE_LINK")
  
  sourcePortId String @db.ObjectId
  sourcePort   Port   @relation("SourceConnection", fields: [sourcePortId], references: [id])
  
  targetPortId String @db.ObjectId
  targetPort   Port   @relation("TargetConnection", fields: [targetPortId], references: [id])
}
